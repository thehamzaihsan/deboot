import { CheckBox, ProgressIndicator } from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct DriveItem {
    id: string,
    name: string,
    size-text: string,
    mount-text: string,
    selected: bool,
    stage-text: string,
    is-busy: bool,
    is-done: bool,
    is-failed: bool,
    error-text: string,
}

export component DriveRow inherits Rectangle {
    in property<DriveItem> item;
    in property<bool> job-running;
    callback toggled();

    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: item.is-failed ? Theme.danger : Theme.border;
    height: 76px;

    HorizontalLayout {
        padding: 14px;
        spacing: Theme.gap;
        alignment: start;

        CheckBox {
            checked: item.selected;
            enabled: !job-running;
            toggled => { toggled(); }
            width: 24px;
        }

        VerticalLayout {
            spacing: 4px;
            alignment: center;

            Text {
                text: item.name;
                color: Theme.text;
                font-size: 15px;
                font-weight: 600;
            }

            Text {
                text: item.size-text + "  ·  " + item.mount-text;
                color: Theme.text-dim;
                font-size: 12px;
            }
        }

        Rectangle { horizontal-stretch: 1; }

        VerticalLayout {
            alignment: center;
            spacing: 4px;
            width: 180px;

            if item.is-busy: Text {
                text: item.stage-text;
                color: Theme.accent;
                font-size: 12px;
                horizontal-alignment: right;
            }
            if item.is-busy: ProgressIndicator {
                indeterminate: true;
                height: 4px;
            }
            if item.is-done: Text {
                text: "✓ " + item.stage-text;
                color: Theme.success;
                font-size: 12px;
                horizontal-alignment: right;
            }
            if item.is-failed: Text {
                text: "✗ " + item.error-text;
                color: Theme.danger;
                font-size: 12px;
                horizontal-alignment: right;
                wrap: word-wrap;
            }
        }
    }
}
